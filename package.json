{
  "name": "python3docs",
  "version": "1.0.0",
  "type": "module",
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,tsx,jsx,vue}": [
      "prettier --write"
    ],
    "apps/docs/**/*.md": [
      "prettier --write",
      "node .claude/skills/table-width/scripts/fix-widths.mjs --auto",
      "node .claude/skills/docs-check/scripts/check.mjs"
    ],
    "*.md": [
      "prettier --write"
    ],
    "*.{css,less,scss,json}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "vitepress dev apps/docs",
    "build": "cross-env NODE_OPTIONS=\\\"--max-old-space-size=8192\\\" vitepress build apps/docs",
    "preview": "vitepress preview apps/docs",
    "docs:dev": "vitepress dev apps/docs",
    "docs:build": "cross-env NODE_OPTIONS=\\\"--max-old-space-size=8192\\\" vitepress build apps/docs",
    "docs:preview": "vitepress preview apps/docs",
    "docs:lint": "markdownlint-cli2 \"apps/docs/**/*.md\" \"README.md\"",
    "docs:clean": "rm -rf apps/docs/.vitepress/.temp apps/docs/.vitepress/cache node_modules/.vite",
    "docs:rebuild": "pnpm run docs:clean && pnpm run docs:build",
    "deploy": "bash scripts/deploy.sh",
    "commit": "cz",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^17.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdownlint-cli2": "^0.23.0",
    "mermaid": "^11.16.0",
    "prettier": "^3.6.2",
    "puppeteer": "^25.19.0",
    "vitepress": "^1.6.4",
    "vitepress-mermaid-viewer": "^0.5.0",
    "vitepress-plugin-lightbox": "^1.0.3",
    "vue": "3.5.38"
  }
}
